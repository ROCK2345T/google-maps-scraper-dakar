# =============================================================================
# LeadScraper Dakar — variables d'environnement
# À définir dans Vercel → Project → Settings → Environment Variables
# (ou dans .env.local pour le développement local). Redéployer après modification.
# =============================================================================

# --- OBLIGATOIRES -------------------------------------------------------------

# Connexion PostgreSQL (Supabase). Utiliser le pooler en mode transaction (port 6543).
DATABASE_URL=postgresql://leadscraper_app.<project_ref>:<mot_de_passe>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Super-administrateur créé automatiquement au premier lancement.
# Le mot de passe ne sert qu'à la création : changez-le ensuite depuis « Mon compte ».
ADMIN_EMAIL=vous@exemple.com
ADMIN_PASSWORD=change-moi

# Secret partagé du moteur de traitement en arrière-plan (chaîne aléatoire longue).
WORKER_SECRET=

# Secret de la tâche planifiée quotidienne (Vercel l'envoie automatiquement).
CRON_SECRET=

# --- SOURCES DE DONNÉES (toutes optionnelles) ---------------------------------
# Sans aucune clé, l'application fonctionne avec Google Maps (lecture directe)
# puis OpenStreetMap en secours. Chaque source ajoutée augmente la fiabilité.

# 1) Google Places API (New) — la plus fiable, officielle, jamais bloquée.
#    console.cloud.google.com → activer « Places API (New) » → créer une clé.
#    Quota gratuit mensuel puis paiement à l'usage.
GOOGLE_PLACES_API_KEY=

# 2) SerpAPI — Google Maps via un service tiers (offre gratuite mensuelle). serpapi.com
SERPAPI_API_KEY=

# 3) Anti-blocage pour la lecture directe de Google Maps :
#    proxys résidentiels en rotation (séparés par des virgules)…
SCRAPER_PROXY_URLS=
#    …ou une passerelle de scraping ({url} est remplacé par l'adresse à lire).
#    Ex : https://api.scraperapi.com/?api_key=XXX&url={url}
SCRAPER_GATEWAY_URL=

# Désactiver la lecture directe de Google Maps (true/false).
DISABLE_GOOGLE_WEB=false

# Ordre personnalisé des sources (défaut : google_places,serpapi,google_web,osm)
SCRAPER_PROVIDER_ORDER=

# Serveurs Overpass (OpenStreetMap) personnalisés, séparés par des virgules.
OVERPASS_ENDPOINTS=

# --- MARQUE & SUPPORT -----------------------------------------------------------
NEXT_PUBLIC_SUPPORT_WHATSAPP=221770000000
NEXT_PUBLIC_SUPPORT_EMAIL=
# URL publique (sinon déduite automatiquement de Vercel)
APP_URL=
